PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
APP_URL=http://localhost:3000

# ---- Database (REQUIRED) ----
# Supabase: Project Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL=

# ---- Photo storage (REQUIRED for permanent photos on Render) ----
# Free account: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (pick ONE method) ----
# BEST for Render free: Resend (https://resend.com → API Keys)
RESEND_API_KEY=

# Optional alternative: Gmail (often times out on free Render)
# Use a 16-character App Password, not your normal Gmail password
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Lost & Found Portal <no-reply@lostfound.app>"
